    </div>

    <div class="page-band page-band--alt page-band--pke-game">
      <button type="button" class="pke-mute-btn" aria-label="Mute P.K.E. game" aria-pressed="false">
        <span class="pke-mute-btn__icon pke-mute-btn__icon--volume" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
