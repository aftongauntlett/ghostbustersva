---
import { getCollection } from "astro:content";
import Button from "../components/ui/Button.astro";
import Lightbox from "../components/ui/Lightbox.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getResponsiveImageAttrs } from "../lib/images.ts";

const screenshots = await getCollection("screenshots");
const screenshotImages = await Promise.all(
  screenshots
    .map(async (item) => {
      if (item.data.rel !== "pke") {
        return Promise.resolve(undefined);
      }
      return {
        ...item,
        responsive: await getResponsiveImageAttrs({
          src: item.data.image,
          widths: [320, 640, 960],
          sizes: "(max-width: 480px) 100vw, (max-width: 768px) 50vw, 33vw",
          width: 640,
          height: 480,
        }),
      };
    })
    .filter(async (item) => await item),
);
---

<BaseLayout
