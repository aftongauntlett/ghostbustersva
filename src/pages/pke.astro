    label="P.K.E. screenshot image viewer"
    lightboxGroup="pke-screenshots"
  />
</BaseLayout>

<script is:inline>
  const PKE_MUTE_STORAGE_KEY = "gbva-pke-muted";
  const PKE_DEFAULT_VOLUME = 0.5;
  const pkeStoredMuted = localStorage.getItem(PKE_MUTE_STORAGE_KEY) === "true";

  window.EJS_player = "#pke";
  window.EJS_core = "atari2600";
  window.EJS_gameName = "GBVA P.K.E.";
  window.EJS_backgroundColor = "#000000";
  window.EJS_startOnLoaded = true;
  window.EJS_volume = pkeStoredMuted ? 0 : PKE_DEFAULT_VOLUME;
  window.EJS_pathtodata = "https://cdn.emulatorjs.org/stable/data/";
  window.EJS_gameUrl = "/games/P.K.E..bin";
  window.EJS_defaultOptions = {
    shader: "crt-lottes",
  };
  window.EJS_onGameStart = () => {
    if (window.EJS_emulator && typeof window.EJS_emulator.setVolume === "function") {
      const muted = localStorage.getItem(PKE_MUTE_STORAGE_KEY) === "true";
      window.EJS_emulator.setVolume(muted ? 0 : PKE_DEFAULT_VOLUME);
    }
  };

  const pkeMuteButton = document.querySelector(".pke-mute-btn");
  const pkeFocusTarget = document.querySelector("#pke");
  const pkeMonitor = document.querySelector("#monitor-container");

  const setPkeMuted = (muted) => {
    localStorage.setItem(PKE_MUTE_STORAGE_KEY, String(muted));
    pkeMuteButton?.setAttribute("aria-pressed", String(muted));
    pkeMuteButton?.setAttribute("aria-label", muted ? "Unmute P.K.E. game" : "Mute P.K.E. game");

    if (window.EJS_emulator && typeof window.EJS_emulator.setVolume === "function") {
      window.EJS_emulator.setVolume(muted ? 0 : PKE_DEFAULT_VOLUME);
    }
  };

  setPkeMuted(pkeStoredMuted);

  pkeMuteButton?.addEventListener("click", () => {
    setPkeMuted(pkeMuteButton.getAttribute("aria-pressed") !== "true");
    pkeFocusTarget?.focus();
  });

  pkeMonitor?.addEventListener("pointerdown", () => {
    pkeFocusTarget?.focus();
  });

  const pkeHasKeyboardFocus = () => {
    const activeElement = document.activeElement;
    return (
      !!activeElement &&
      (activeElement === pkeFocusTarget || pkeFocusTarget?.contains(activeElement))
    );
  };

  const pressPkeFire = (pressed) => {
    if (window.EJS_emulator?.gameManager?.simulateInput) {
      window.EJS_emulator.gameManager.simulateInput(0, 0, pressed ? 1 : 0);
    }
  };

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || event.repeat || !pkeHasKeyboardFocus()) {
      return;
    }

    event.preventDefault();
    pressPkeFire(true);
  });

  document.addEventListener("keyup", (event) => {
    if (event.key !== "Enter" || !pkeHasKeyboardFocus()) {
      return;
    }

    event.preventDefault();
    pressPkeFire(false);
  });
</script>
<script src="https://cdn.emulatorjs.org/stable/data/loader.js"></script>

<style>
  .page-band--pke-game {
    position: relative;
  }

  .pke-mute-btn {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    cursor: pointer;
    box-shadow: var(--shadow-panel);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .pke-mute-btn:hover,
  .pke-mute-btn:focus-visible {
    color: var(--color-text);
    border-color: var(--color-hover-border);
  }

  .pke-mute-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .pke-mute-btn[aria-pressed="true"] {
    color: var(--color-gb-caution);
    border-color: var(--color-gb-caution);
  }

  .pke-mute-btn__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pke-mute-btn__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .pke-mute-btn__icon--muted,
  .pke-mute-btn[aria-pressed="true"] .pke-mute-btn__icon--volume {
    display: none;
  }

  .pke-mute-btn[aria-pressed="true"] .pke-mute-btn__icon--muted {
    display: flex;
  }

  .game-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .game-hint {
    margin: var(--space-xl) 0 0;
    padding: var(--space-sm) var(--space-xl);
    color: var(--color-gb-caution);
    background-color: var(--color-meter-panel-bg);
    border: 2px solid var(--color-gb-caution);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-panel);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    text-align: center;
  }

  .controls {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .controls dl {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    justify-content: center;
    align-items: center;
  }
  .controls dt {
    border: solid 0.05em #333333;
    background-color: #dedede;
    border-radius: 5px;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 24px;
    height: 26px;
  }
  .controls dd {
    margin-right: 4px;
  }
  .controls p {
    margin-top: 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .mobile-warning {
    display: none;
  }

  .gamematrix-title {
    width: 360px;
    max-width: 80dvw;
  }
  .gamematrix-table {
    border-collapse: collapse;
  }
  .gamematrix-table th {
    border: 0;
    font-weight: normal;
    font-size: 13px;
    line-height: 16px;
    text-align: right;
    padding-right: 5px;
  }
  .gamematrix-table thead th {
    text-align: center;
    padding-right: 0;
    padding-bottom: 5px;
  }
  .gamematrix-table thead th:first-of-type {
    text-align: right;
    padding-right: 5px;
  }
  .gamematrix-table td {
    border: 1px solid #222222;
    width: 38px;
    height: 38px;
  }
  .gamematrix-table td.easy {
    background-color: #0476b9;
  }
  .gamematrix-table td.complex {
    background-color: #ed220d;
  }
  .gamematrix-table td.locator {
    background-color: #60d938;
  }
  .gamematrix-table td.bonus {
    background-color: #fef156;
  }
  .gamematrix-table td.direction {
    background-color: #ac3a8c;
  }
  .gamematrix-table tfoot td {
    border: 0;
    font-style: italic;
    font-size: 12px;
  }

  #monitor-container {
    width: 889px;
    height: 813px;
    position: relative;
  }

  #monitor-top,
  #monitor-right,
  #monitor-bottom,
  #monitor-left {
    /* Decorative bezel overlays sit above the emulator (z-index: 2) but must not
       intercept clicks on the EmulatorJS controls underneath. */
    pointer-events: none;
  }
  #monitor-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 889px;
    height: 153px;
    z-index: 2;
    background-image: url("/images/franklin-monitor-top.png");
  }
  #monitor-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 131px;
    height: 813px;
    z-index: 2;
    background-image: url("/images/franklin-monitor-right.png");
  }
  #monitor-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 889px;
    height: 183px;
    z-index: 2;
    background-image: url("/images/franklin-monitor-bottom.png");
  }
  #monitor-left {
    position: absolute;
    top: 0;
    left: 0;
    width: 135px;
    height: 813px;
    z-index: 2;
    background-image: url("/images/franklin-monitor-left.png");
  }

  #pke {
    position: relative;
    z-index: 1;
    width: 680px;
    height: 560px;
    padding: 50px 20px 30px;
    top: 100px;
    margin: auto;
    background-color: black;
    aspect-ratio: 1.33;
  }

  :global(#pke.ejs_big_screen .ejs_menu_bar) {
    right: 2rem;
    bottom: 1.75rem;
    left: 2rem;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  :global(#pke.ejs_big_screen .ejs_menu_bar_hidden) {
    transform: translateY(calc(100% + 1.75rem));
  }

  :global(#pke.ejs_small_screen .ejs_menu_bar) {
    bottom: 1.75rem;
  }

  :global(#pke.ejs_small_screen .ejs_menu_bar_hidden) {
    transform: translate(-50%, calc(100% + 1.75rem));
  }

  .gallery-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
  }

  .gallery-thumb__expand {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-overlay-dark-soft);
    color: var(--color-text-inverse);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 1;
  }

  @media (max-width: 889px) {
    #monitor-container {
      scale: 0.3;
      margin: -275px;
    }
    .gamematrix-table {
      scale: 0.8;
    }
    .mobile-warning {
      display: block;
    }
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gallery-item {
    margin: 0;
  }

  /* Slide content */
  .gallery-slide {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    width: 100%;
    display: block;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }
  .gallery-slide:hover {
    border-color: var(--color-hover-border);
    box-shadow: var(--shadow-elevated-media);
  }
  .gallery-slide__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .gallery-slide:hover .gallery-slide__img {
    transform: scale(1.03);
  }
  .gallery-slide__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-overlay-dark-soft);
    color: var(--color-text-inverse);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    z-index: 1;
  }
  .gallery-slide:hover .gallery-slide__overlay,
  .gallery-slide:focus-visible .gallery-slide__overlay {
    opacity: 1;
  }
</style>
