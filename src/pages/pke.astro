</BaseLayout>

<script is:inline>
  const PKE_MUTE_STORAGE_KEY = "gbva-pke-muted";
  const PKE_DEFAULT_VOLUME = 0.5;
  const pkeStoredMuted = localStorage.getItem(PKE_MUTE_STORAGE_KEY) === "true";
  // Below this width the game is replaced by a "best viewed on desktop"
  // screenshot with no mute control, so skip the emulator (and its audio).
  const pkeIsMobile = window.matchMedia("(max-width: 889px)").matches;

  if (!pkeIsMobile) {
    window.EJS_player = "#pke";
    window.EJS_core = "atari2600";
    window.EJS_gameName = "GBVA P.K.E.";
    window.EJS_backgroundColor = "#000000";
    window.EJS_startOnLoaded = true;
    window.EJS_volume = pkeStoredMuted ? 0 : PKE_DEFAULT_VOLUME;
    window.EJS_pathtodata = "https://cdn.emulatorjs.org/stable/data/";
    window.EJS_gameUrl = "/games/P.K.E..bin";
    window.EJS_defaultOptions = {
      shader: "crt-lottes",
    };
    window.EJS_onGameStart = () => {
      if (window.EJS_emulator && typeof window.EJS_emulator.setVolume === "function") {
        const muted = localStorage.getItem(PKE_MUTE_STORAGE_KEY) === "true";
        window.EJS_emulator.setVolume(muted ? 0 : PKE_DEFAULT_VOLUME);
      }
    };

    const loaderScript = document.createElement("script");
    loaderScript.src = "https://cdn.emulatorjs.org/stable/data/loader.js";
    document.body.appendChild(loaderScript);
  }

  const pkeMuteButton = document.querySelector(".pke-mute-btn");
  const pkeFocusTarget = document.querySelector("#pke");
  const pkeMonitor = document.querySelector("#monitor-container");

  const setPkeMuted = (muted) => {
    localStorage.setItem(PKE_MUTE_STORAGE_KEY, String(muted));
    pkeMuteButton?.setAttribute("aria-pressed", String(muted));
    pkeMuteButton?.setAttribute("aria-label", muted ? "Unmute P.K.E. game" : "Mute P.K.E. game");

    if (window.EJS_emulator && typeof window.EJS_emulator.setVolume === "function") {
      window.EJS_emulator.setVolume(muted ? 0 : PKE_DEFAULT_VOLUME);
    }
  };

  setPkeMuted(pkeStoredMuted);

  pkeMuteButton?.addEventListener("click", () => {
    setPkeMuted(pkeMuteButton.getAttribute("aria-pressed") !== "true");
    pkeFocusTarget?.focus();
  });

  pkeMonitor?.addEventListener("pointerdown", () => {
    pkeFocusTarget?.focus();
  });

  const pkeHasKeyboardFocus = () => {
    const activeElement = document.activeElement;
    return (
      !!activeElement &&
      (activeElement === pkeFocusTarget || pkeFocusTarget?.contains(activeElement))
    );
  };

  const pressPkeFire = (pressed) => {
    if (window.EJS_emulator?.gameManager?.simulateInput) {
      window.EJS_emulator.gameManager.simulateInput(0, 0, pressed ? 1 : 0);
    }
  };

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || event.repeat || !pkeHasKeyboardFocus()) {
      return;
    }

    event.preventDefault();
    pressPkeFire(true);
  });

  document.addEventListener("keyup", (event) => {
    if (event.key !== "Enter" || !pkeHasKeyboardFocus()) {
      return;
    }

    event.preventDefault();
    pressPkeFire(false);
  });
</script>

<style>
  /* Press Start 2P (latin) — OFL licensed, self-hosted from Google Fonts for the
     control keys and game matrix headings to give them an arcade/Atari feel. */
  @font-face {
    font-family: "Press Start 2P";
    src: url("/fonts/press-start-2p.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  .page-band--pke-game {
    position: relative;
  }

  .pke-mute-btn {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    cursor: pointer;
    box-shadow: var(--shadow-panel);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .pke-mute-btn:hover,
  .pke-mute-btn:focus-visible {
    color: var(--color-text);
    border-color: var(--color-hover-border);
  }

  .pke-mute-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .pke-mute-btn[aria-pressed="true"] {
    color: var(--color-gb-caution);
    border-color: var(--color-gb-caution);
  }

  .pke-mute-btn__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pke-mute-btn__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .pke-mute-btn__icon--muted,
  .pke-mute-btn[aria-pressed="true"] .pke-mute-btn__icon--volume {
    display: none;
  }

  .pke-mute-btn[aria-pressed="true"] .pke-mute-btn__icon--muted {
    display: flex;
  }

  .game-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .game-hint {
    margin: var(--space-xl) 0 0;
    padding: var(--space-sm) var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    color: var(--color-text);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-panel);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    text-align: center;
  }

  .controls {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .controls-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .controls-list__group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm) var(--space-md);
  }

  .control-chip {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-lg) var(--space-xs) var(--space-xs);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .key {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0 var(--space-sm);
    font-family: "Press Start 2P", var(--font-body);
    font-size: 0.65rem;
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    background-color: var(--color-surface);
    border: 2px solid var(--color-text);
    border-radius: 0;
    box-shadow: 2px 2px 0 var(--color-text);
    vertical-align: middle;
  }

  .key-icon {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
  }

  .key-icon--down {
    transform: rotate(180deg);
  }

  .key-icon--left {
    transform: rotate(-90deg);
  }

  .key-icon--right {
    transform: rotate(90deg);
  }

  .game-screenshot {
    display: none;
    width: 100%;
    max-width: 480px;
    height: auto;
    margin-top: var(--space-xl);
    border-radius: var(--radius-md);
  }

  .larger-screen-note {
    display: none;
    margin-top: var(--space-lg);
    padding: var(--space-sm) var(--space-xl);
    color: var(--color-text-muted);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-panel);
    font-size: var(--text-sm);
    font-style: italic;
    text-align: center;
  }

  .gamematrix-title {
    display: block;
    width: 280px;
    max-width: 70dvw;
    height: auto;
    margin-top: var(--space-2xl);
  }

  .gamematrix-intro {
    margin-top: var(--space-md);
  }

  .gamematrix-wrap {
    margin-top: var(--space-xl);
    box-shadow: var(--shadow-panel);
  }

  .gamematrix-table {
    border-collapse: collapse;
    border: 2px solid var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text);
  }
  .gamematrix-table th,
  .gamematrix-table td {
    border: 1px solid var(--color-text);
  }
  .gamematrix-table th {
    font-weight: var(--weight-bold);
    text-align: right;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-surface-alt);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .gamematrix-table thead th {
    text-align: center;
    padding: var(--space-xs);
    font-family: "Press Start 2P", var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0;
  }
  .gamematrix-table thead th:first-of-type {
    text-align: right;
    padding-right: var(--space-sm);
  }
  .gamematrix-table td {
    width: 36px;
    height: 36px;
    background-color: var(--color-surface);
  }
  .gamematrix-table td.easy {
    background-color: #0476b9;
  }
  .gamematrix-table td.complex {
    background-color: #ed220d;
  }
  .gamematrix-table td.locator {
    background-color: #60d938;
  }
  .gamematrix-table td.bonus {
    background-color: #fef156;
  }
  .gamematrix-table td.direction {
    background-color: #ac3a8c;
  }

  .gamematrix-footnote {
    margin-top: var(--space-sm);
    font-style: italic;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  #monitor-container {
    width: 889px;
    height: 813px;
    position: relative;
  }

  #monitor-top,
  #monitor-right,
  #monitor-bottom,
  #monitor-left {
    /* Decorative bezel overlays sit above the emulator (z-index: 2) but must not
       intercept clicks on the EmulatorJS controls underneath. */
    pointer-events: none;
  }
  #monitor-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 889px;
    height: 153px;
    z-index: 2;
    background-image: url("/images/franklin-monitor-top.png");
  }
  #monitor-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 131px;
    height: 813px;
    z-index: 2;
    background-image: url("/images/franklin-monitor-right.png");
  }
  #monitor-bottom {
    position: absolute;
