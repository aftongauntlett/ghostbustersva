# Environment variable template
# Copy to .env for local development and set matching values in Vercel.

# Primary production origin used for canonical tags and sitemap generation.
SITE_URL=https://ghostbustersva.com

# Resend email delivery (required)
RESEND_API_KEY=re_your_key_here
CONTACT_FROM_EMAIL=hello@yourdomain.com
CONTACT_TO_EMAIL=your-inbox@example.com

# Upstash Redis rate limiting (recommended — memory fallback used if absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (optional — leave blank unless you intentionally enable it)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Maps (existing)
# GOOGLE_MAPS_API_KEY=
